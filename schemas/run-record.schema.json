{
  "$defs": {
    "CandidateKind": {
      "enum": [
        "source",
        "wheel"
      ],
      "title": "CandidateKind",
      "type": "string"
    },
    "CandidateRecord": {
      "additionalProperties": false,
      "properties": {
        "dirty": {
          "default": false,
          "title": "Dirty",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/CandidateKind"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "package": {
          "title": "Package",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "source_commit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "test_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Source"
        }
      },
      "required": [
        "package",
        "kind",
        "location"
      ],
      "title": "CandidateRecord",
      "type": "object"
    },
    "CommandResult": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "title": "Classification",
          "type": "string"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "duration_seconds": {
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "returncode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Returncode"
        },
        "stderr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stderr"
        },
        "stdout": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stdout"
        },
        "timed_out": {
          "default": false,
          "title": "Timed Out",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "command",
        "duration_seconds",
        "classification"
      ],
      "title": "CommandResult",
      "type": "object"
    },
    "ComparisonResult": {
      "additionalProperties": false,
      "properties": {
        "actual_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Sha256"
        },
        "comparator": {
          "title": "Comparator",
          "type": "string"
        },
        "comparator_version": {
          "title": "Comparator Version",
          "type": "string"
        },
        "differences": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Differences",
          "type": "array"
        },
        "expected_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Sha256"
        },
        "ignored_fields": {
          "items": {
            "type": "string"
          },
          "title": "Ignored Fields",
          "type": "array"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "policy": {
          "title": "Policy",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ComparisonStatus"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "tolerances": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Tolerances",
          "type": "object"
        }
      },
      "required": [
        "status",
        "kind",
        "comparator",
        "comparator_version",
        "policy",
        "summary"
      ],
      "title": "ComparisonResult",
      "type": "object"
    },
    "ComparisonStatus": {
      "enum": [
        "equal",
        "expected-change",
        "different",
        "invalid",
        "error"
      ],
      "title": "ComparisonStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/CandidateRecord"
      },
      "title": "Candidates",
      "type": "array"
    },
    "commands": {
      "items": {
        "$ref": "#/$defs/CommandResult"
      },
      "title": "Commands",
      "type": "array"
    },
    "comparisons": {
      "items": {
        "$ref": "#/$defs/ComparisonResult"
      },
      "title": "Comparisons",
      "type": "array"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "environment": {
      "additionalProperties": true,
      "title": "Environment",
      "type": "object"
    },
    "failure_stage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Stage"
    },
    "fixture_sets": {
      "items": {
        "type": "string"
      },
      "title": "Fixture Sets",
      "type": "array"
    },
    "framework_version": {
      "title": "Framework Version",
      "type": "string"
    },
    "known_failure_results": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Known Failure Results",
      "type": "array"
    },
    "profile": {
      "title": "Profile",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": true,
      "title": "Provenance",
      "type": "object"
    },
    "retained_outputs": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Retained Outputs",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "source_lock": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Lock"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "title": "Status",
      "type": "string"
    },
    "wheel_lock": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wheel Lock"
    },
    "worker_protocol_version": {
      "title": "Worker Protocol Version",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "framework_version",
    "worker_protocol_version",
    "profile",
    "status",
    "started_at",
    "seed"
  ],
  "title": "RunRecord",
  "type": "object"
}
