{
  "$defs": {
    "SourceRecord": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "default_branch": {
          "title": "Default Branch",
          "type": "string"
        },
        "license_id": {
          "title": "License Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "owner": {
          "title": "Owner",
          "type": "string"
        },
        "repository": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Repository",
          "type": "string"
        },
        "tree": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Tree",
          "type": "string"
        }
      },
      "required": [
        "name",
        "repository",
        "commit",
        "tree",
        "default_branch",
        "owner",
        "license_id"
      ],
      "title": "SourceRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "impact_graph": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Impact Graph",
      "type": "object"
    },
    "lock_id": {
      "title": "Lock Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRecord"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "lock_id",
    "sources"
  ],
  "title": "SourceLock",
  "type": "object"
}
